# Copy this file to ".env" and paste your real key below.
# NEVER share .env or upload it to GitHub - it is in .gitignore for that reason.

# Give each provider its OWN line - every provider with a key shows up in VerityAi.
# (Don't write LLM_API_KEY twice: only the last one would count.)

# Groq (free) - key from https://console.groq.com/keys
GROQ_API_KEY=paste-your-key-here

# Google Gemini (free) - key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=paste-your-key-here

# Main provider + default judge model
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# For Gemini as main provider instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# Optional: OPENAI_API_KEY=...   OPENROUTER_API_KEY=... (free Llama models)
